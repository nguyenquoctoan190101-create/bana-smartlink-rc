# Backend (required outside unit tests)
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=
BANA_COMMUNE_ID=ba_na
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional legacy HS256 fallback only; leave empty for modern JWKS projects.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Comma-separated roles. Enable only after the MFA enrollment screen has been
# deployed and privileged users have an authenticator app available.
MFA_REQUIRED_ROLES=
# Optional app-layer network gate. When set, /app and every request carrying a
# bearer token are accepted only from these IPv4/IPv6 CIDRs; public citizen
# endpoints remain reachable. Example: 203.0.113.10/32,2001:db8:1234::/48
INTERNAL_ALLOWED_IP_CIDRS=

# Gemini is optional. Leave blank to disable AI/OCR in a safe local demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_OCR_MODEL=gemini-2.5-flash
# External document OCR is experimental and is forcibly disabled outside
# development/test until a privacy-safe local semantic redaction gate exists.
FEATURE_EXTERNAL_OCR=false

# Experimental/admin-only modules. Keep disabled until the responsible unit
# approves the operating procedure and evidence needed for each module.
FEATURE_IOT_PILOT=false
FEATURE_TOURISM_PILOT=false
FEATURE_DIGITAL_MATURITY=false
FEATURE_SCENARIO_SIMULATION=false

# Optional Web Push. In-app notifications work without these values.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# Frontend. Only VITE_* values are exposed to the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
